# PostgreSQL connection used by SQLAlchemy and Alembic.
DATABASE_URL=postgresql+psycopg://pathaid:pathaid@localhost:5432/pathaid
# Only browser requests from this frontend origin may mutate auth/profile data.
PATHAID_PUBLIC_ORIGIN=http://localhost:3000
# Set true when the API is served over HTTPS so cookies are HTTPS-only.
PATHAID_SECURE_COOKIES=false
# Single administrator identity and an encoded scrypt password hash.
PATHAID_ADMIN_EMAIL=admin@example.com
PATHAID_ADMIN_PASSWORD_HASH=
# Optional server-side AI credentials. Never commit real values.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Select openai or gemini explicitly; the matching key stays server-side.
PATHAID_EXTRACTION_PROVIDER=gemini
PATHAID_EXTRACTION_MODEL=gemini-3.5-flash-lite
PATHAID_RECOMMENDATION_PROVIDER=gemini
PATHAID_RECOMMENDATION_MODEL=gemini-3.5-flash-lite
PATHAID_EXTRACTION_TIMEOUT_SECONDS=30
PATHAID_EXTRACTION_MAX_OUTPUT_TOKENS=4000
PATHAID_EXTRACTION_MAX_SOURCE_CHARACTERS=120000
PATHAID_RECOMMENDATION_TIMEOUT_SECONDS=15
PATHAID_RECOMMENDATION_MAX_OUTPUT_TOKENS=300
PATHAID_RECOMMENDATION_ATTEMPTS_PER_HOUR=10
# One worker is expected by default; leases recover interrupted stages.
PATHAID_WORKER_POLL_SECONDS=2
PATHAID_WORKER_LEASE_SECONDS=120
PATHAID_INGESTION_MAX_ATTEMPTS=3
PATHAID_INGESTION_RETRY_BASE_SECONDS=5
# The scheduler poll interval also separates same-host source batches.
PATHAID_SCHEDULER_POLL_SECONDS=60
PATHAID_SCHEDULER_BATCH_SIZE=25
PATHAID_SCHEDULER_USER_AGENT=PathaidBot/1.0
