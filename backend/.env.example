# PostgreSQL connection used by SQLAlchemy and Alembic.
DATABASE_URL=postgresql+psycopg://pathaid:pathaid@localhost:5432/pathaid
# Only browser requests from this frontend origin may mutate auth/profile data.
PATHAID_PUBLIC_ORIGIN=http://localhost:3000
# Set true when the API is served over HTTPS so cookies are HTTPS-only.
PATHAID_SECURE_COOKIES=false
