# Optional non-secret local development settings. The native app chooses the
# normal macOS Application Support directory when these are omitted.
PATHAID_DATA_DIR=
PATHAID_DATABASE_PATH=
PATHAID_WEB_ORIGIN=http://127.0.0.1:3000

# The unpacked extension ID is not a secret. Configure it only after building
# and loading the extension. Tokens and API keys belong in macOS Keychain.
PATHAID_EXTENSION_ID=
PATHAID_KEYCHAIN_SERVICE=com.pathaid.local
PATHAID_SQLITE_BUSY_TIMEOUT_MS=5000
PATHAID_API_PORT=8000
PATHAID_WEB_PORT=3000

# Provider behavior is non-secret configuration. Save the Gemini API key with:
#   cd backend && .venv/bin/python -m app.local_admin set-gemini-key
PATHAID_EXTRACTION_PROVIDER=gemini
PATHAID_EXTRACTION_MODEL=gemini-3.5-flash-lite
PATHAID_EXTRACTION_TIMEOUT_SECONDS=30
PATHAID_EXTRACTION_MAX_OUTPUT_TOKENS=4000
PATHAID_EXTRACTION_MAX_SOURCE_CHARACTERS=120000
