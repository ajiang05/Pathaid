{$PATHAID_HOSTNAME} {
	encode zstd gzip

	# Browser security headers that do not interfere with Next.js runtime scripts.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Expose only the API's value-free health responses for external uptime
	# checks. The API service itself remains private on the Compose network.
	handle /health/* {
		reverse_proxy api:8000
	}

	# All browser traffic, including same-origin /api requests, goes through
	# Next.js. Its rewrite forwards API calls to the private FastAPI service.
	handle {
		reverse_proxy frontend:3000
	}
}
