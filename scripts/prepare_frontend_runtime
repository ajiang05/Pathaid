#!/usr/bin/env bash
# Assemble the Next.js standalone output used by the native macOS launcher.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FRONTEND_ROOT="$(cd "${SCRIPT_DIR}/../frontend" && pwd)"

if [[ ! -f "${FRONTEND_ROOT}/.next/standalone/server.js" || ! -d "${FRONTEND_ROOT}/.next/static" ]]; then
  echo "Standalone frontend output is missing. Run: npm --prefix frontend run build" >&2
  exit 1
fi

# Next's standalone bundle intentionally omits assets copied by a container's
# final stage. Native launches need the same directory layout beside server.js.
mkdir -p "${FRONTEND_ROOT}/public" "${FRONTEND_ROOT}/.next/standalone/.next"
cp -R "${FRONTEND_ROOT}/.next/static" "${FRONTEND_ROOT}/.next/standalone/.next/static"
cp -R "${FRONTEND_ROOT}/public" "${FRONTEND_ROOT}/.next/standalone/public"
